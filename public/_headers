# No long cache on hashed build output (/_next/static/*, /workbox-*.js). Cloudflare applies _headers to 404
# responses too, and the edge caches them: with an immutable rule here, a
# browser that asks for a chunk in the seconds after a deploy, or for an
# old chunk, keeps that 404 for a year (measured 2026-10-12). The default
# (max-age=0, must-revalidate + ETag) costs only free revalidations.

# Model filenames are stable (/glb/animals_pack/Alpaca.glb), not content-hashed,
# so a replaced model keeps its URL. Cache hard but stay able to pick that up.
/glb/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Same reasoning for the lighting image every pack page loads.
/hdri/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=2592000

/og-image.png
  Cache-Control: public, max-age=2592000

# The service worker decides how long everything else is cached, so it must not
# be cached itself.
/sw.js
  Cache-Control: no-cache
