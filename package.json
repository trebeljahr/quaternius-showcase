{
  "name": "react-three-next",
  "version": "2.0.0",
  "description": "Fan-made 3D viewer for the free low-poly model packs by Quaternius. Not affiliated with Quaternius.",
  "homepage": "https://quaternius.trebeljahr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/quaternius-showcase.git"
  },
  "bugs": {
    "url": "https://github.com/trebeljahr/quaternius-showcase/issues"
  },
  "author": "Rico Trebeljahr",
  "authors": [
    "Rico Trebeljahr"
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-three/drei": "9.40.0",
    "@react-three/fiber": "^8.9.0",
    "case": "^1.6.3",
    "leva": "^0.9.34",
    "next": "^15.5.24",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-merge-refs": "^2.0.1",
    "three": "^0.146.0",
    "three-stdlib": "^2.17.3",
    "tunnel-rat": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@next/bundle-analyzer": "^15.5.24",
    "@types/node": "^18.11.10",
    "@types/react": "^18.0.26",
    "@types/three": "^0.146.0",
    "autoprefixer": "^10.4.12",
    "file-loader": "^6.2.0",
    "glslify": "^7.1.1",
    "glslify-loader": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1"
  },
  "scripts": {
    "lint": "biome lint .",
    "dev": "node scripts/dev.js",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "preview": "npx --yes serve out",
    "generateExports": "tsx ./scripts/codeGenExports.ts",
    "verify:downloads": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-download-links.mjs",
    "marketing:screenshots": "node scripts/marketing/capture-screenshots.mjs",
    "marketing:social-preview": "node scripts/marketing/render-social-preview.mjs",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "lodash.pick": "file:vendor/lodash-pick",
      "postcss@8": "8.5.28",
      "serialize-javascript": "7.0.5",
      "fflate@0.6": "0.6.11",
      "colord@2": "2.9.4",
      "@babel/core@7": "7.29.6",
      "@babel/plugin-transform-modules-systemjs@7": "7.29.4",
      "ws@7": "7.5.11",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "fast-uri@3": "3.1.8",
      "postcss-selector-parser@6": "6.1.3",
      "browserslist@4": "4.28.7",
      "baseline-browser-mapping@2": "2.11.0"
    }
  }
}
